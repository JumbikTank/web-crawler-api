    {
      "id": "YxkfmwuyrGWoinhxlqV_o",
      "type": "text",
      "x": 3563.3413748626062,
      "y": -987.2515840569579,
      "width": 1619.088623046875,
      "height": 207.6826693794883,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
