# SQLite works without cloud credentials; .env is loaded with --env-file.
STORAGE_BACKEND=sqlite
DATABASE_PATH=data/crawler.sqlite3

# Only needed for STORAGE_BACKEND=aws:
AWS_DEFAULT_REGION=us-east-1
DYNAMODB_TABLE=url_data
S3_BUCKET=crawler-html
# AWS_ENDPOINT_URL=http://localhost:4566
# Use AWS_PROFILE or environment variables for credentials; do not commit them.
