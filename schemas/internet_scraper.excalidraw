    {
      "id": "4C3bxq_oYZAPtoGyiTZnr",
      "type": "text",
      "x": 1363.5666406495761,
      "y": -586.1585759248906,
      "width": 1162.61962890625,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
